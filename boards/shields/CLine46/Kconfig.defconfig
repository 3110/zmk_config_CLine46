if SHIELD_CLINE46_R

config ZMK_KEYBOARD_NAME
    default "CLine46"

config ZMK_BLE
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config INPUT
    default y

config ZMK_POINTING
    default y

config SPI
    default y

# cormoran 版ドライバ（Studio RPC 付き）。badjeff 版の PMW3610_ALT ではない
config PMW3610
    default y

endif


if SHIELD_CLINE46_R || SHIELD_CLINE46_L

# NFCT_PINS_AS_GPIOS は Zephyr 4.1 で Kconfig から devicetree の
# &uicr { nfct-pins-as-gpios; } に移された(CLine46.dtsi 参照)

config ZMK_SPLIT
    default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 30

config RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL
    default 10

endif